{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "format": {
      "default": "vertical",
      "description": "vertical = 1080x1920 (Shorts, Reels); landscape = 1920x1080 (YouTube).",
      "type": "string",
      "enum": [
        "vertical",
        "landscape"
      ]
    },
    "language": {
      "description": "Free text, for your own records and the AI check, e.g. \"en-IN\" or \"hi\".",
      "type": "string"
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Scene number, 1..n in playing order."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Exact narration. Voiced on its own (unless `audio` is set) and shown as karaoke subtitles."
          },
          "visual": {
            "description": "Image or video for this scene: a path, a URL, or a bare file name looked up in assetDirs. Missing = a \"VISUAL NEEDED\" slot.",
            "type": "string"
          },
          "audio": {
            "description": "The scene's own recorded voice (e.g. cut from your footage). Used instead of TTS.",
            "type": "string"
          },
          "layout": {
            "description": "fullbleed = fills the canvas; framed = tall screenshot in a phone frame that scrolls; fitted = shown whole over a blurred copy. Default: picked from the file's shape.",
            "type": "string",
            "enum": [
              "fullbleed",
              "framed",
              "fitted"
            ]
          },
          "visualNeeded": {
            "description": "Plain description of the shot this line needs; shown in the placeholder while `visual` is missing.",
            "type": "string"
          },
          "hookText": {
            "description": "Scene 1: a short (<= 6 words) on-screen hook shown huge for the first ~2 s.",
            "type": "string"
          },
          "hookTone": {
            "description": "Hook accent: alert = red, curiosity = yellow, proof = green.",
            "type": "string",
            "enum": [
              "alert",
              "curiosity",
              "proof"
            ]
          },
          "hookPosition": {
            "type": "string",
            "enum": [
              "top",
              "center"
            ]
          },
          "badge": {
            "description": "Small label at the top of the frame, e.g. \"⚠️ Privacy alert\".",
            "type": "string"
          },
          "badgeCue": {
            "description": "Narration word at which the badge appears.",
            "type": "string"
          },
          "panY": {
            "description": "Framed screenshots: vertical focus [from, to] in % (0 = top).",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "panCue": {
            "description": "Framed screenshots: scroll from the first narration word to the second.",
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "sfx": {
            "type": "object",
            "properties": {
              "sound": {
                "type": "string",
                "description": "A built-in name (see `cutsmith sfx`), a file path or a URL."
              },
              "cue": {
                "type": "string",
                "description": "Narration word the sound plays on."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "sound",
              "cue"
            ]
          },
          "hideSubtitles": {
            "description": "No subtitles on this scene (e.g. they would cover text already on screen).",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "voice": {
      "default": {
        "provider": "none",
        "wordsPerSecond": 2.6
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "openai-compatible",
              "description": "Any /v1/audio/speech endpoint: OpenAI, a proxy in front of Gemini TTS, a local Kokoro server, ..."
            },
            "baseURL": {
              "description": "Default https://api.openai.com/v1.",
              "type": "string"
            },
            "apiKeyEnv": {
              "default": "OPENAI_API_KEY",
              "description": "Name of the environment variable holding the key (never the key itself).",
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "voice": {
              "type": "string"
            },
            "instructions": {
              "description": "Delivery style sent as `instructions` (accent, pace, mood).",
              "type": "string"
            },
            "prefix": {
              "description": "Text sent before every line, for models that read stage directions from the text itself (e.g. Gemini TTS director's notes).",
              "type": "string"
            },
            "format": {
              "default": "wav",
              "type": "string",
              "enum": [
                "wav",
                "mp3"
              ]
            }
          },
          "required": [
            "provider",
            "model",
            "voice"
          ]
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "none",
              "description": "No voice: silent scenes timed at `wordsPerSecond`. For drafts and tests."
            },
            "wordsPerSecond": {
              "default": 2.6,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "provider"
          ]
        }
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "volume": {
          "default": 0.025,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "file"
      ]
    },
    "brand": {
      "anyOf": [
        {
          "type": "string",
          "description": "Path to a brand.json"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "colors": {
              "default": {},
              "type": "object",
              "properties": {
                "background": {
                  "default": "#111827",
                  "type": "string"
                },
                "backgroundDeep": {
                  "default": "#030712",
                  "type": "string"
                },
                "accent": {
                  "default": "#38BDF8",
                  "type": "string"
                },
                "onAccent": {
                  "default": "#030712",
                  "description": "Text colour on the accent (end-card button).",
                  "type": "string"
                },
                "text": {
                  "default": "#FFFFFF",
                  "type": "string"
                },
                "frame": {
                  "default": "#1F2937",
                  "description": "Border of the phone frame around screenshots.",
                  "type": "string"
                }
              }
            },
            "font": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "description": "CSS font family name."
                },
                "files": {
                  "description": "Local font files (ttf/otf/woff2).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string"
                      },
                      "weight": {
                        "default": "700",
                        "type": "string"
                      },
                      "style": {
                        "default": "normal",
                        "type": "string"
                      }
                    },
                    "required": [
                      "src"
                    ]
                  }
                },
                "googleFont": {
                  "description": "Load the family from Google Fonts instead, e.g. \"Inter:wght@700;800;900\". Needs network while rendering.",
                  "type": "string"
                },
                "fallback": {
                  "default": "'Noto Sans Devanagari', -apple-system, 'Segoe UI', Roboto, sans-serif",
                  "type": "string"
                }
              },
              "required": [
                "family"
              ]
            },
            "logo": {
              "description": "Logo on the end card (PNG/SVG, light on dark).",
              "type": "string"
            }
          }
        }
      ]
    },
    "endCard": {
      "description": "false = no end card. Left out = no end card.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "button": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "subline": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            },
            "seconds": {
              "default": 3,
              "description": "How long it covers the end of the last scene (never more than 60% of it).",
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    },
    "transitions": {
      "default": {},
      "type": "object",
      "properties": {
        "whoosh": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "progressBar": {
      "default": true,
      "type": "boolean"
    },
    "subtitles": {
      "default": {},
      "type": "object",
      "properties": {
        "wordsPerChunk": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "uppercase": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "assetDirs": {
      "default": [],
      "description": "Folders searched for bare file names in visual/audio/music.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lint": {
      "default": true,
      "description": "Print short-form retention warnings (vertical only). Never blocks.",
      "type": "boolean"
    }
  },
  "required": [
    "scenes"
  ]
}
